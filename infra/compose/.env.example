# Settings for infra/compose/docker-compose.yml (full stack).
#   cp .env.example .env   — `.env` is git-ignored; never commit it.
# Compose reads this file automatically when run from infra/compose/ (or pass --env-file).
# Values are only used for compose interpolation; containers receive what docker-compose.yml passes them.

# ── Required ──────────────────────────────────────────────────────────────────────────────────────────
# Encrypts secrets at rest (IdP client secrets, LDAP bind passwords, ...). Base64 of 32 random bytes:
#   openssl rand -base64 32
# Losing it makes those secrets unrecoverable — store it in your password manager / secret store.
ISBP_MASTER_KEY=
# Previous key during a rotation (reads accept both, writes use ISBP_MASTER_KEY). Leave empty otherwise.
ISBP_MASTER_KEY_PREVIOUS=

# ── Database (bundled Postgres) ───────────────────────────────────────────────────────────────────────
# Change the password for anything beyond a laptop. It is embedded in a URL: use URL-safe characters
# only (e.g. `openssl rand -hex 24`). Changing it after the volume exists requires ALTER ROLE as well.
POSTGRES_USER=isbp
POSTGRES_PASSWORD=isbp
POSTGRES_DB=isbp
DATABASE_POOL_MAX=10

# ── Web ───────────────────────────────────────────────────────────────────────────────────────────────
# Public origin users browse to. Must be https:// in production — session cookies are only marked
# Secure when it is (put a TLS-terminating reverse proxy in front of the web port).
PUBLIC_URL=http://localhost:3000
# Published address of the web app. 127.0.0.1 = this machine only; 0.0.0.0 to expose it (behind TLS!).
WEB_BIND=127.0.0.1
WEB_PORT=3000

# ── Images ────────────────────────────────────────────────────────────────────────────────────────────
# Defaults build locally (`docker compose up --build`). To run published images instead:
#   ISBP_API_IMAGE=ghcr.io/<owner>/isbp-api  ISBP_WEB_IMAGE=ghcr.io/<owner>/isbp-web  ISBP_IMAGE_TAG=main
ISBP_API_IMAGE=isbp-api
ISBP_WEB_IMAGE=isbp-web
ISBP_IMAGE_TAG=local

# ── App ───────────────────────────────────────────────────────────────────────────────────────────────
LOG_LEVEL=info
# OpenAPI reference at /api/docs (consider false on internet-facing deployments).
API_DOCS=true

# ── Demo seed (`--profile demo` only) — demo credentials, never for real deployments ──────────────────
SEED_ADMIN_PASSWORD=ChangeMe-2026!
SEED_DEMO_PASSWORD=Demo-2026!pass

# ── Observability (`--profile observability`) ─────────────────────────────────────────────────────────
# Set to http://jaeger:4318 to send traces to the bundled Jaeger; empty disables tracing.
OTEL_EXPORTER_OTLP_ENDPOINT=
JAEGER_UI_PORT=16686
PROMETHEUS_PORT=9090
