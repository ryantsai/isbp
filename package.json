{
  "name": "isbp",
  "private": true,
  "description": "IS Big Platform — unified resource management for IS operations",
  "packageManager": "pnpm@12.10.1",
  "engines": {
    "node": ">=24.11"
  },
  "type": "module",
  "scripts": {
    "dev": "turbo run dev --filter=@isbp/api --filter=@isbp/web",
    "dev:services": "pnpm --filter @isbp/dev-services start",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:integration": "pnpm --filter @isbp/api test:integration",
    "e2e": "pnpm --filter @isbp/e2e e2e",
    "sim": "tsx tooling/flow-sim/src/cli.ts",
    "sim:stack": "bash tooling/flow-sim/stack.sh",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:generate": "turbo run db:generate",
    "db:migrate": "pnpm --filter @isbp/api migrate",
    "db:seed": "pnpm --filter @isbp/api seed",
    "db:reset": "pnpm --filter @isbp/api db:reset",
    "modules:sync": "tsx packages/create-module/src/cli.ts sync",
    "modules:check": "tsx packages/create-module/src/cli.ts sync --check",
    "create-module": "tsx packages/create-module/src/cli.ts create",
    "docs:reference": "tsx packages/create-module/src/cli.ts docs",
    "docs:check": "tsx packages/create-module/src/cli.ts docs --check && tsx packages/create-module/src/cli.ts guide --check",
    "docs:guide": "tsx packages/create-module/src/cli.ts guide",
    "docs:screenshots": "pnpm --filter @isbp/e2e screenshots",
    "astryx": "pnpm --filter @isbp/ui exec astryx",
    "ui:theme": "pnpm --filter @isbp/ui theme:build",
    "ui:check": "pnpm --filter @isbp/ui ui:check",
    "ai:eval": "pnpm --filter @isbp/api ai:eval"
  },
  "devDependencies": {
    "prettier": "catalog:",
    "tsx": "catalog:",
    "turbo": "catalog:",
    "typescript": "catalog:"
  }
}
