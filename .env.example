# IS Big Platform — environment reference with safe LOCAL defaults.
#
#   cp .env.example .env        (`.env` is git-ignored — never commit real values)
#
# Every value below equals the built-in default of the API/web for local development, so copying this
# file is optional with `pnpm dev:services` or infra/compose/docker-compose.dev.yml. The API's pnpm scripts
# (dev, migrate, seed) load ./.env automatically when it exists.
# Production values come from your orchestrator (Helm values + Secret, or infra/compose/.env) — see
# docs/deployment.md.
# Variables marked [secret] must come from a secret store in production.

# ── Runtime ───────────────────────────────────────────────────────────────────────────────────────────
# development | test | production. Production requires ISBP_MASTER_KEY and disables AUTO_MIGRATE.
NODE_ENV=development
# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info
# Human-readable logs (needs the pino-pretty devDependency; defaults to on for an interactive dev terminal).
# LOG_PRETTY=true

# ── API (apps/api) ────────────────────────────────────────────────────────────────────────────────────
HOST=0.0.0.0
# API port (the web dev server uses WEB_PORT, so the two never collide).
# PORT=4000
# Internal-only server: /metrics (Prometheus), /healthz, /readyz. Never expose it publicly.
METRICS_PORT=9464

# [secret] Postgres 17+ with pg_trgm and pgvector (`vector`; the embedded dev Postgres falls back to a slower
# portable vector column — see docs/deployment.md §7b).
DATABASE_URL=postgres://isbp:isbp@localhost:5432/isbp
DATABASE_POOL_MAX=10
# [secret] Redis 7+ (BullMQ queues, permission cache, rate limits, pub/sub). Must use maxmemory-policy noeviction.
REDIS_URL=redis://localhost:6379
# Apply migrations on API start. Default: true outside production, false in production (run `migrate` instead).
# AUTO_MIGRATE=true

# Public origin of the web app: SSO redirect URIs, OpenAPI server URL, and the cookie `Secure` flag
# (cookies are Secure only when this starts with https://).
PUBLIC_URL=http://localhost:3000
# Proxies whose X-Forwarded-* headers are trusted: true | false | comma-separated list of IPs/CIDRs/presets.
TRUST_PROXY=loopback,linklocal,uniquelocal

# [secret] Master key for secrets at rest (AES-256-GCM): base64 of 32 random bytes. REQUIRED in production.
#   openssl rand -base64 32
# Unset in development = a fixed, publicly known dev key (never use that for real data).
# ISBP_MASTER_KEY=
# [secret] Previous master key while rotating (reads accept both keys, writes use ISBP_MASTER_KEY).
# ISBP_MASTER_KEY_PREVIOUS=

# Sessions
SESSION_TTL_HOURS=12
SESSION_REMEMBER_DAYS=14
SESSION_IDLE_MINUTES=240
# Brute-force protection
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCK_MINUTES=15
# Global API rate limit (requests per minute per user or IP)
RATE_LIMIT_MAX=1200

# Worker (dist/worker.js)
WORKER_CONCURRENCY=10

# OpenAPI reference at /api/docs and /api/openapi.json (default true).
API_DOCS=true

# ── Phase 1: notifications & API clients ──────────────────────────────────────────────────────────────
# Email (SMTP) is configured in the UI: Administration → Notifications → Email (password encrypted at rest).
# Notification webhooks (Teams/Slack/generic) may target private/loopback addresses only when this is true.
# Default: true outside production, false in production (SSRF guard).
# ISBP_ALLOW_PRIVATE_WEBHOOKS=
# Lifetime of OAuth client-credentials access tokens issued at POST /api/v1/oauth/token.
OAUTH_TOKEN_TTL_SECONDS=3600

# ── Phase 2: AI gateway ──────────────────────────────────────────────────────────────────────────────
# Models, keys (encrypted at rest), masking and the monthly budget are configured in the UI:
# Administration → AI. Without a model, AI features run in their builtin (offline) mode.

# ── Attachments (Phase 3: files on records — contracts, ticket screenshots, …) ─────────────────────────
# local = a directory (default in development: .dev-data/files; in containers mount a volume at
# /var/lib/isbp/files) · s3 = an S3-compatible bucket (AWS S3, MinIO, Ceph …), recommended for HA.
# FILES_STORAGE=local
# FILES_DIR=
# S3_BUCKET=
# S3_REGION=us-east-1
# S3_ENDPOINT=https://minio.example.internal:9000
# S3_FORCE_PATH_STYLE=true
# Leave the keys out to use the default AWS credential chain (IAM role / IRSA / workload identity).
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_PREFIX=files/
# S3_SSE=AES256
# ClamAV clamd for malware scanning of every upload; uploads are refused while it is unreachable.
# CLAMAV_HOST=
# CLAMAV_PORT=3310

# ── Telemetry (OpenTelemetry tracing — disabled unless the endpoint is set) ─────────────────────────────
# OTLP/HTTP base URL, e.g. http://localhost:4318 (the SDK appends /v1/traces).
# OTEL_EXPORTER_OTLP_ENDPOINT=
# isbp-api by default; the worker/migrate processes should set isbp-worker / isbp-migrate.
# OTEL_SERVICE_NAME=isbp-api
# Reported as service.version (images set it to the build version).
# APP_VERSION=0.1.0
# Kill switch: OTEL_SDK_DISABLED=true

# ── Script sandbox (Scheduled jobs → script jobs) ─────────────────────────────────────────────────────
# Where scripts run: kubernetes (a Job per run in SANDBOX_K8S_NAMESPACE, Helm chart sets this up), docker
# (Engine API at SANDBOX_DOCKER_HOST), local (DEVELOPMENT ONLY: a child process, not isolated; refused in
# production) or none. Default: local outside production, none in production.
# SANDBOX_RUNNER=local
# SANDBOX_IMAGES=python:3.13-alpine,node:24-alpine,mcr.microsoft.com/powershell:lts-alpine-3.20,alpine:3.22
# SANDBOX_DOCKER_HOST=unix:///var/run/docker.sock
# SANDBOX_K8S_NAMESPACE=isbp-sandbox

# ── Driver tests (`pnpm --filter @isbp/sql test:drivers`) — run against whichever engines are set ─────
# ISBP_TEST_PG_URL=postgres://isbp:isbp@localhost:5432/isbp_test
# ISBP_TEST_MSSQL_URL=mssql://sa:Password1!@localhost:1433/master
# ISBP_TEST_MYSQL_URL=mysql://root:password@127.0.0.1:3306/isbp_drv
# ISBP_TEST_ORACLE_URL=oracle://isbp:isbp@localhost:1521/FREEPDB1

# ── Demo seed (`pnpm db:seed` / dist/seed.js) — demo data and credentials, never for production ─────────
SEED_ADMIN_PASSWORD=ChangeMe-2026!
SEED_DEMO_PASSWORD=Demo-2026!pass
# Stand-ins for ServiceDesk Plus and Azure DevOps Server (both on-premises) (tooling/integration-mocks, started by
# `pnpm dev:services`). The seed connects the demo integrations to them when this is set; it defaults to
# http://localhost:4100 outside production.
# INTEGRATION_MOCKS_URL=http://localhost:4100

# ── Web (apps/web) ────────────────────────────────────────────────────────────────────────────────────
# Where the Next.js server forwards /api/* and where Server Components call the API. Read at runtime,
# so one image works in every environment (compose: http://api:4000, Kubernetes: http://<release>-api:4000).
API_INTERNAL_URL=http://localhost:4000
# Port of `pnpm dev`'s web server (default 3000). The production standalone server (Docker/Helm) listens
# on PORT (default 3000) and HOSTNAME (0.0.0.0 in containers).
# WEB_PORT=3000
NEXT_TELEMETRY_DISABLED=1

# ── Local tooling ─────────────────────────────────────────────────────────────────────────────────────
# Ports for `pnpm dev:services` (embedded Postgres + Redis) and infra/compose/docker-compose.dev.yml.
DEV_PG_PORT=5432
DEV_REDIS_PORT=6379
# Integration tests (`pnpm test:integration`) must point at a throwaway database, never the app database.
# DATABASE_URL=postgres://isbp:isbp@localhost:5432/isbp_test
# Playwright (`pnpm e2e`): the running web app, seeded with the demo data (admin / ChangeMe-2026!).
E2E_BASE_URL=http://localhost:3000
