{
  "name": "@isbp/module-itam",
  "version": "0.1.0",
  "private": true,
  "description": "IT asset management: hardware, software licences, contracts and vendors",
  "type": "module",
  "isbp": {
    "module": true,
    "id": "itam"
  },
  "exports": {
    "./manifest": "./src/manifest.ts",
    "./contracts": "./src/contracts.ts",
    "./model": "./src/model.ts",
    "./schema": "./src/server/schema.ts",
    "./services": "./src/server/services.ts",
    "./server": "./src/server/index.ts",
    "./web": "./src/web/index.tsx",
    "./messages/*": "./messages/*"
  },
  "scripts": {
    "db:generate": "drizzle-kit generate && isbp-embed-migrations migrations",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@isbp/contracts": "workspace:*",
    "@isbp/db": "workspace:*",
    "@isbp/module-cmdb": "workspace:*",
    "@isbp/sdk": "workspace:*",
    "drizzle-orm": "catalog:",
    "zod": "catalog:"
  },
  "peerDependencies": {
    "@hookform/resolvers": "*",
    "@isbp/ui": "workspace:*",
    "fastify": "*",
    "lucide-react": "*",
    "motion": "*",
    "next": "*",
    "next-intl": "*",
    "react": "*",
    "react-hook-form": "*"
  },
  "peerDependenciesMeta": {
    "@hookform/resolvers": {
      "optional": true
    },
    "@isbp/ui": {
      "optional": true
    },
    "lucide-react": {
      "optional": true
    },
    "motion": {
      "optional": true
    },
    "next": {
      "optional": true
    },
    "next-intl": {
      "optional": true
    },
    "react": {
      "optional": true
    },
    "react-hook-form": {
      "optional": true
    }
  },
  "devDependencies": {
    "@hookform/resolvers": "catalog:",
    "@isbp/eslint-config": "workspace:*",
    "@isbp/i18n": "workspace:*",
    "@isbp/tsconfig": "workspace:*",
    "@isbp/ui": "workspace:*",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "drizzle-kit": "catalog:",
    "eslint": "catalog:",
    "fastify": "catalog:",
    "fastify-type-provider-zod": "catalog:",
    "lucide-react": "catalog:",
    "motion": "catalog:",
    "next": "catalog:",
    "next-intl": "catalog:",
    "react": "catalog:",
    "react-hook-form": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
