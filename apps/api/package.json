{
  "name": "@isbp/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --clear-screen=false --env-file-if-exists=../../.env --import ./src/telemetry.ts src/dev.ts",
    "dev:api": "tsx watch --env-file-if-exists=../../.env --import ./src/telemetry.ts src/main.ts",
    "dev:worker": "tsx watch --env-file-if-exists=../../.env --import ./src/telemetry.ts src/worker.ts",
    "build": "tsdown",
    "start": "node --import ./dist/telemetry.js dist/main.js",
    "start:worker": "node --import ./dist/telemetry.js dist/worker.js",
    "migrate": "tsx --env-file-if-exists=../../.env src/migrate.ts",
    "seed": "tsx --env-file-if-exists=../../.env src/seed.ts",
    "db:reset": "tsx --env-file-if-exists=../../.env src/migrate.ts --reset && tsx --env-file-if-exists=../../.env src/seed.ts",
    "openapi": "tsx src/openapi.ts",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --project unit",
    "test:integration": "vitest run --project integration"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.131.0",
    "@aws-sdk/client-s3": "^3.1146.0",
    "@faker-js/faker": "^10.6.0",
    "@fastify/cookie": "^11.1.2",
    "@fastify/formbody": "^9.0.0",
    "@fastify/helmet": "^13.1.1",
    "@fastify/multipart": "^10.1.2",
    "@fastify/rate-limit": "^11.2.0",
    "@fastify/swagger": "^9.9.1",
    "@isbp/contracts": "workspace:*",
    "@isbp/db": "workspace:*",
    "@isbp/i18n": "workspace:*",
    "@isbp/module-alm": "workspace:*",
    "@isbp/module-announcements": "workspace:*",
    "@isbp/module-cmdb": "workspace:*",
    "@isbp/module-helpdesk-ai": "workspace:*",
    "@isbp/module-itam": "workspace:*",
    "@isbp/module-itsm": "workspace:*",
    "@isbp/module-knowledge": "workspace:*",
    "@isbp/module-projects": "workspace:*",
    "@isbp/sdk": "workspace:*",
    "@node-rs/argon2": "^2.2.1",
    "@node-saml/node-saml": "^5.1.0",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/auto-instrumentations-node": "^0.80.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.222.0",
    "@opentelemetry/resources": "^2.11.0",
    "@opentelemetry/sdk-node": "^0.222.0",
    "@opentelemetry/semantic-conventions": "^1.43.0",
    "@scalar/fastify-api-reference": "^1.73.0",
    "bullmq": "^6.3.11",
    "drizzle-orm": "catalog:",
    "fastify": "catalog:",
    "fastify-plugin": "catalog:",
    "fastify-type-provider-zod": "catalog:",
    "file-type": "^22.1.1",
    "intl-messageformat": "^12.1.2",
    "ioredis": "^5.11.1",
    "ldapts": "^9.2.0",
    "nodemailer": "^10.0.14",
    "openid-client": "^6.8.8",
    "pg": "catalog:",
    "pino": "^10.4.0",
    "prom-client": "^15.1.3",
    "uuid": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@isbp/eslint-config": "workspace:*",
    "@isbp/tsconfig": "workspace:*",
    "@types/node": "catalog:",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "catalog:",
    "eslint": "catalog:",
    "pino-pretty": "^13.2.0",
    "tsdown": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
