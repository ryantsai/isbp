{
  "name": "@isbp/ui",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./src/index.ts",
    "./theme/tel": {
      "types": "./src/theme/built/tel.d.ts",
      "default": "./src/theme/built/tel.js"
    },
    "./theme/tel.css": "./src/theme/built/tel.css",
    "./*": "./src/components/*.tsx",
    "./lib/*": "./src/lib/*.ts"
  },
  "scripts": {
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "theme:build": "astryx theme build src/theme/tel.ts --out src/theme/built/tel.css",
    "theme:check": "astryx theme build src/theme/tel.ts --out src/theme/built/tel.css --check",
    "ui:check": "node scripts/ui-check.mjs"
  },
  "dependencies": {
    "@astryxdesign/core": "catalog:",
    "@astryxdesign/theme-neutral": "catalog:",
    "@codemirror/autocomplete": "^6.20.3",
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lang-python": "^6.2.1",
    "@codemirror/lang-sql": "^6.10.0",
    "@codemirror/language": "^6.12.4",
    "@codemirror/legacy-modes": "^6.5.4",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.13",
    "@isbp/i18n": "workspace:*",
    "@isbp/sdk": "workspace:*",
    "@lezer/highlight": "^1.2.5",
    "@stylexjs/stylex": "catalog:",
    "@tanstack/react-query": "catalog:",
    "@tanstack/react-table": "catalog:",
    "clsx": "catalog:",
    "lucide-react": "catalog:",
    "motion": "catalog:",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "tailwind-merge": "catalog:"
  },
  "peerDependencies": {
    "next": "*",
    "next-intl": "*",
    "react": "*",
    "react-dom": "*",
    "react-hook-form": "*"
  },
  "devDependencies": {
    "@astryxdesign/cli": "catalog:",
    "@isbp/eslint-config": "workspace:*",
    "@isbp/tsconfig": "workspace:*",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "eslint": "catalog:",
    "next": "catalog:",
    "next-intl": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "react-hook-form": "catalog:",
    "typescript": "catalog:"
  }
}
