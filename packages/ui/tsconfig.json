{
  "extends": "@isbp/tsconfig/react.json",
  "compilerOptions": {
    // `@isbp/ui/<name>` is a component, as in package.json "exports".
    "paths": {
      "@isbp/ui/lib/*": ["./src/lib/*"],
      "@isbp/ui/hooks/*": ["./src/hooks/*"],
      "@isbp/ui/*": ["./src/components/*"]
    }
  },
  "include": ["src", "recipes"]
}
